# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=
# Optional fallback provider
GROQ_API_KEY=

# 1 = use canned mock answers (no API calls). 0 = real API calls.
MOCK_LLM=1

# Model names (check the list your key can use; free-tier names change often)
GEMINI_MODEL=
GROQ_MODEL=

# Call budget and throttle
SESSION_CALL_CAP=60
DAILY_CALL_CAP=200
REQUESTS_PER_MINUTE=8
